{
  "description": "vibe-coding-guide 强制护栏：极窄硬拦 + 红线弹确认",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard-bash.sh"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard-write.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
